{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compodoc": "npx compodoc -s",
    "compodoc:build": "npx compodoc -p ./tsconfig.json -n 'API'",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "lint:fix": "tslint --fix -p tsconfig.json -c tslint.json",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/schedule": "12.0.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "12.0.1",
    "@node-saml/node-saml": "5.1.0",
    "@node-saml/passport-saml": "5.1.0",
    "@types/express-serve-static-core": "5.1.3",
    "@types/qs": "6.15.1",
    "@types/saml2-js": "3.0.4",
    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "date-fns": "4.4.0",
    "express-session": "1.19.0",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "nestjs-pino": "5.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pixl-xml": "1.0.13",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "saml2-js": "4.0.4",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.1",
    "url": "0.11.4",
    "zod": "4.6.1",
    "xmlbuilder2": "4.0.3"
  },
  "devDependencies": {
    "@babel/parser": "8.0.5",
    "@babel/types": "8.0.5",
    "@compodoc/compodoc": "2.0.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cron": "2.4.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "@types/passport-jwt": "4.0.1",
    "@types/prettier": "3.0.0",
    "@types/supertest": "7.2.1",
    "better-sqlite3": "12.11.1",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslint": "6.1.3",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/../test/setEnv.ts"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "2.3.0",
    "saml2-js": {
      "xmlbuilder2": {
        "js-yaml": "3.15.2"
      }
    }
  }
}
